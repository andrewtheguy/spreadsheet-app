import { Palette } from "std-widgets.slint";

// Colours and metrics that aren't in the stock `Palette`. Everything here derives from the
// active light/dark scheme, so the app follows the OS appearance without a manual toggle.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // Secondary text: file paths, row counts, hints.
    out property <brush> dimmed: root.dark ? #9e9e9e : #6f6f6f;

    // Panel chrome.
    out property <brush> panel-background: root.dark ? #202020 : #fbfbfb;
    out property <brush> grid-line: Palette.border;
    out property <brush> header-background: Palette.alternate-background;
    out property <brush> header-pressed: root.dark ? #ffffff14 : #00000014;

    // Comparison-status row tints. Deliberately translucent so they blend with whatever the
    // row would otherwise be, keeping the foreground text legible in both schemes.
    out property <brush> tint-diff: root.dark ? #fa525245 : #fa52522e;
    out property <brush> tint-only-left: root.dark ? #fd7e1445 : #fd7e142e;
    out property <brush> tint-only-right: root.dark ? #228be645 : #228be62e;

    // Summary-badge fills, matching the row tints plus a neutral and a "matched" green.
    out property <brush> badge-neutral: root.dark ? #ffffff1f : #0000000f;
    out property <brush> badge-matched: root.dark ? #40c05745 : #40c0572e;
    out property <brush> badge-diff: root.tint-diff;
    out property <brush> badge-only-left: root.tint-only-left;
    out property <brush> badge-only-right: root.tint-only-right;

    // Error/success strip in the header.
    out property <brush> error-background: root.dark ? #fa525240 : #ffe3e3;
    out property <brush> success-background: root.dark ? #40c05740 : #d3f9d8;

    out property <length> gap: 12px;
    out property <length> panel-padding: 10px;
    out property <length> radius: 6px;
}

// The shared bordered container used for the Left/Right panels and the operation panel.
export component Panel inherits Rectangle {
    background: Theme.panel-background;
    border-color: Theme.grid-line;
    border-width: 1px;
    border-radius: Theme.radius;
    clip: true;
}

// A small pill used for the comparison summary tallies.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <brush> tint;

    background: root.tint;
    border-radius: 4px;
    height: 20px;
    width: label.preferred-width + 16px;

    label := Text {
        x: 8px;
        text: root.text;
        color: Palette.foreground;
        font-size: 11px;
        vertical-alignment: center;
        height: 100%;
    }
}
